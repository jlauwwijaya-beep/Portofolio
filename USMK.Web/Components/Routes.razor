@using Microsoft.AspNetCore.Components.Routing

<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <LayoutView Layout="@typeof(MainLayout)">
                        <div class="page-center">
                            <div class="card card-pad card-narrow text-center">
                                <span class="icon-bubble icon-bubble-danger">!</span>
                                <h1 class="mt-3">Akses ditolak</h1>
                                <p class="text-muted">
                                    Halaman ini hanya untuk pengelola. Kalau kamu peserta,
                                    buka menu <strong>Kerjakan Ujian</strong> ya.
                                </p>
                                <a class="btn btn-primary" href="kerjakan-ujian">Ke halaman ujian</a>
                            </div>
                        </div>
                    </LayoutView>
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="page-center">
                <div class="card card-pad card-narrow text-center">
                    <span class="icon-bubble">404</span>
                    <h1 class="mt-3">Halaman tidak ditemukan</h1>
                    <p class="text-muted">Alamat yang kamu buka tidak ada di aplikasi ini.</p>
                    <a class="btn btn-primary" href="/">Kembali ke beranda</a>
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>