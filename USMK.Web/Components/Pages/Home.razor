@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@inject UsmkApi Api
@inject NavigationManager Nav

<PageTitle>Beranda · USMK</PageTitle>

@if (IsAdmin)
{
    <div class="page-header">
        <div>
            <span class="eyebrow">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor"
                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M13 2L3 14h8l-1 8 10-12h-8l1-8z" />
                </svg>
                USMK · Dasbor Admin
            </span>
            <h1>@Salam, Guru.</h1>
            <p class="text-muted">Ringkasan paket ujian dan pintasan cepat mengelola.</p>
        </div>
        <div class="btn-row">
            <a class="btn btn-primary" href="paket-ujian/baru">Buat Paket Ujian</a>
            <a class="btn btn-ghost" href="rekap">Lihat Rekap</a>
        </div>
    </div>

    @if (error is not null)
    {
        <div class="alert alert-danger">@error</div>
    }
    else if (memuat)
    {
        <div class="card"><div class="skeleton-stack">@for (var i = 0; i < 3; i++) { <div class="skeleton"></div> }</div></div>
    }
    else
    {
        <div class="stat-grid">
            <div class="stat">
                <span class="stat-icon" style="background:var(--grad-biru)">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 3H6a2 2 0 00-2 2v14a2 2 0 002 2h12a2 2 0 002-2V9z" />
                        <path d="M14 3v6h6" />
                        <path d="M8 13h8M8 17h5" />
                    </svg>
                </span>
                <span>
                    <span class="stat-label">Total Paket</span>
                    <span class="stat-value">@pakets.Count</span>
                </span>
            </div>
            <div class="stat">
                <span class="stat-icon" style="background:var(--grad-hijau)">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 6L9 17l-5-5" />
                    </svg>
                </span>
                <span>
                    <span class="stat-label">Aktif / Dibuka</span>
                    <span class="stat-value">@pakets.Count(p => p.IsPublished && p.StatusJadwal == "Dibuka")</span>
                </span>
            </div>
            <div class="stat">
                <span class="stat-icon" style="background:var(--grad-kuning)">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9" />
                        <path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4L16.5 3.5z" />
                    </svg>
                </span>
                <span>
                    <span class="stat-label">Draft</span>
                    <span class="stat-value">@pakets.Count(p => !p.IsPublished)</span>
                </span>
            </div>
            <div class="stat">
                <span class="stat-icon" style="background:var(--grad-ungu)">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M22 21v-2a4 4 0 00-3-3.87" />
                        <path d="M16 3.13a4 4 0 010 7.75" />
                    </svg>
                </span>
                <span>
                    <span class="stat-label">Total Pengerjaan</span>
                    <span class="stat-value">@totalPengerjaan</span>
                </span>
            </div>
        </div>

        <div class="card" style="margin-top:18px">
            <div class="card-head">
                <h2>Paket Ujian Terbaru</h2>
                <a class="btn btn-ghost btn-sm" href="paket-ujian">Lihat semua →</a>
            </div>

            @if (pakets.Count == 0)
            {
                <div class="empty">
                    <span class="icon-bubble icon-bubble-lg icon-bubble-ungu">
                        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 3H6a2 2 0 00-2 2v14a2 2 0 002 2h12a2 2 0 002-2V9z" />
                            <path d="M14 3v6h6" />
                            <path d="M8 13h8M8 17h5" />
                        </svg>
                    </span>
                    <h3>Belum ada paket ujian</h3>
                    <p>Mulai dari membuat paket pertama, lalu tambahkan bagian dan soalnya.</p>
                    <a class="btn btn-primary" href="paket-ujian/baru">Buat paket ujian</a>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th style="width:64px">ID</th>
                                <th>Judul</th>
                                <th style="width:110px">Mata Pelajaran</th>
                                <th style="width:80px">Soal</th>
                                <th style="width:110px">Dikerjakan</th>
                                <th style="width:120px">Status</th>
                                <th class="actions" style="width:230px">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in pakets.Take(5))
                            {
                                <tr>
                                    <td class="num">#@p.Id</td>
                                    <td class="grow"><span class="cell-strong">@p.Judul</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(p.MataPelajaran) ? "—" : p.MataPelajaran)</td>
                                    <td class="num">@p.JumlahSoal</td>
                                    <td class="num">@p.JumlahPengerjaan</td>
                                    <td>
                                        @if (!p.IsPublished)
                                        {
                                            <span class="badge badge-abu">Draft</span>
                                        }
                                        else
                                        {
                                            @switch (p.StatusJadwal)
                                            {
                                                case "Dibuka":
                                                    <span class="badge badge-hijau"><span class="dot-status"></span> Aktif</span>
                                                    break;
                                                case "BelumDibuka":
                                                    <span class="badge badge-kuning">Belum dibuka</span>
                                                    break;
                                                default:
                                                    <span class="badge badge-abu">Ditutup</span>
                                                    break;
                                            }
                                        }
                                    </td>
                                    <td class="actions">
                                        <a class="btn btn-primary btn-sm" href="@($"paket-ujian/{p.Id}")">Kelola</a>
                                        <button class="btn btn-quiet btn-sm" disabled="@(sedangDuplikat == p.Id)"
                                                @onclick="() => DuplikatAsync(p.Id)">
                                            @(sedangDuplikat == p.Id ? "Menyalin..." : "Duplikat")
                                        </button>
                                        <a class="btn btn-ghost btn-sm" href="@($"paket-ujian/{p.Id}/peserta")">Peserta</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
}
else
{
    <div class="page-stack">
        <section class="hero">
            <div class="hero-text">
                <span class="eyebrow">USMK · Sistem Ujian Online</span>
                <h1>@Salam.</h1>
                <p class="text-muted">Pilih paket ujian yang sedang dibuka, isi jawabanmu, lalu cek kembali jawabanmu sebelum dikirim. Jawaban tersimpan otomatis, jadi aman kalau koneksi terputus sebentar.</p>
                <div class="btn-row">
                    <a class="btn btn-primary btn-lg" href="kerjakan-ujian">Kerjakan Ujian</a>
                </div>
            </div>
            <div class="hero-art" aria-hidden="true">
                <div class="hero-blob b1"></div>
                <div class="hero-blob b2"></div>
                <div class="hero-blob b3"></div>
            </div>
        </section>
    </div>
}

@code {
    private bool IsAdmin { get; set; }
    private List<PaketUjianBankDto> pakets = new();
    private bool memuat = true;
    private string? error;
    private int? sedangDuplikat;

    private int totalPengerjaan => pakets.Sum(p => p.JumlahPengerjaan);

    private static string Salam
    {
        get
        {
            var jam = DateTime.Now.Hour;
            if (jam < 11) return "Selamat pagi";
            if (jam < 15) return "Selamat siang";
            if (jam < 18) return "Selamat sore";
            return "Selamat malam";
        }
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null)
            return;

        var user = (await AuthState).User;
        IsAdmin = user.IsInRole(DbSeeder.AdminRole);

        if (IsAdmin)
            await MuatPaketAsync();
    }

    private async Task MuatPaketAsync()
    {
        memuat = true;
        var hasil = await Api.AmbilDaftarPaketAsync();

        if (hasil.Berhasil)
        {
            pakets = hasil.Data!;
            error = null;
        }
        else
        {
            pakets = new();
            error = hasil.Error;
        }

        memuat = false;
    }

    private async Task DuplikatAsync(int id)
    {
        if (sedangDuplikat is not null)
            return;

        sedangDuplikat = id;
        var hasil = await Api.DuplikatPaketAsync(id);
        sedangDuplikat = null;

        if (hasil.Berhasil && hasil.Data?.Id is { } idBaru)
            Nav.NavigateTo($"paket-ujian/{idBaru}");
        else
            await MuatPaketAsync();
    }
}