@page "/access-denied"
@attribute [AllowAnonymous]

<PageTitle>Akses Ditolak · USMK</PageTitle>

<div class="page-center">
    <div class="card card-pad card-narrow text-center">
        <span class="icon-bubble icon-bubble-lg icon-bubble-danger">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor"
                 stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="10" width="16" height="11" rx="3" />
                <path d="M8 10V7a4 4 0 118 0v3" />
            </svg>
        </span>

        <h1 class="mt-3">Akses ditolak</h1>
        <p class="text-muted">
            Halaman ini khusus untuk pengelola ujian. Kalau kamu peserta, buka menu
            <strong>Kerjakan Ujian</strong> ya.
        </p>

        <div class="btn-row" style="justify-content:center">
            <a class="btn btn-primary" href="kerjakan-ujian">Ke halaman ujian</a>
            <form method="post" action="/account/logout" style="margin:0">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-ghost">Ganti akun</button>
            </form>
        </div>
    </div>
</div>