@page "/paket-ujian/{Id:int}"
@attribute [Authorize(Roles = DbSeeder.AdminRole)]
@rendermode InteractiveServer
@inject UsmkApi Api
@inject NavigationManager Nav

<PageTitle>@(paket?.Judul ?? "Paket Ujian") · USMK</PageTitle>

@if (memuat)
{
    <div class="card card-narrow" style="margin:0 auto">
        <div class="skeleton-stack">
            <div class="skeleton" style="height:70px"></div>
            <div class="skeleton" style="height:140px"></div>
            <div class="skeleton" style="height:140px"></div>
        </div>
    </div>
}
else if (paket is null)
{
    <div class="alert alert-danger">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
             stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 8v5M12 16h.01" />
        </svg>
        @(error ?? "Paket ujian tidak ditemukan.")
    </div>
}
else
{
    <div class="page-header">
        <div>
            <a class="muted-sm" href="paket-ujian">← Daftar paket ujian</a>
            <h1 class="mt-1">
                @paket.Judul
                @if (paket.IsPublished)
                {
                    <span class="badge badge-hijau" style="vertical-align:middle"><span class="dot-status"></span> Aktif</span>
                }
                else
                {
                    <span class="badge badge-abu" style="vertical-align:middle">Draft</span>
                }
            </h1>
            <p class="text-muted">
                @if (!string.IsNullOrWhiteSpace(paket.MataPelajaran))
                {
                    <span class="badge badge-biru">@paket.MataPelajaran</span>
                }
                @if (!string.IsNullOrWhiteSpace(paket.Kelas))
                {
                    <span class="badge badge-ungu">@paket.Kelas</span>
                }
                <span>@paket.Bagians.Count bagian · @JumlahSoal soal</span>
            </p>
            <p class="text-muted" style="margin-top:4px">
                @if (paket.DurasiMenit > 0)
                {
                    <span class="badge badge-abu">@paket.DurasiMenit menit</span>
                }
                else
                {
                    <span class="badge badge-abu">Tanpa batas waktu</span>
                }
                @if (PakaiJadwal)
                {
                    <span class="badge badge-biru">Buka @paket.WaktuBuka.ToString("dd MMM yyyy HH:mm")</span>
                    <span class="badge badge-biru">Tutup @paket.WaktuTutup.ToString("dd MMM yyyy HH:mm")</span>
                }
                else
                {
                    <span class="badge badge-kuning">Selalu terbuka</span>
                }
                @if (paket.AcakUrutan)
                {
                    <span class="badge badge-ungu">Urutan acak</span>
                }
                else
                {
                    <span class="badge badge-abu">Urutan tetap</span>
                }
            </p>
        </div>
        <div class="btn-row">
            <a class="btn btn-ghost" href="@($"paket-ujian/{Id}/peserta")">Lihat Peserta</a>
            <a class="btn btn-ghost" href="@($"paket-ujian/{Id}/ubah")">Ubah Info</a>
            <button class="btn btn-ghost" disabled="@(sedangAksi)" @onclick="() => DuplikatAsync()">
                @(sedangAksi ? "..." : "Duplikat")
            </button>
            @if (paket.IsPublished)
            {
                <button class="btn btn-quiet" disabled="@(sedangAksi)" @onclick="() => TutupAsync()">
                    @(sedangAksi ? "..." : "Kembalikan ke Draft")
                </button>
            }
            else
            {
                <button class="btn btn-primary" disabled="@(sedangAksi || JumlahSoal == 0)" @onclick="() => PublishAsync()"
                        title="@(JumlahSoal == 0 ? "Tambahkan soal dulu" : "Publikasikan ke siswa")">
                    @(sedangAksi ? "..." : "Publikasikan")
                </button>
            }
        </div>
    </div>

    <div class="tabs">
        <a class="tab tab-aktif" href="@($"paket-ujian/{Id}")">Susun Soal</a>
        <a class="tab" href="@($"paket-ujian/{Id}/ubah")">Info &amp; Jadwal</a>
        <a class="tab" href="@($"paket-ujian/{Id}/peserta")">Peserta</a>
    </div>

    @if (pesan is not null)
    {
        <div class="alert alert-success">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 6L9 17l-5-5" />
            </svg>
            @pesan
        </div>
    }

    @if (error is not null)
    {
        <div class="alert alert-danger">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                 stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 8v5M12 16h.01" />
            </svg>
            @error
        </div>
    }

    @if (paket.IsPublished)
    {
        <div class="alert alert-info">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                 stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 16v-5M12 8h.01" />
            </svg>
            Paket sudah aktif dan bisa dikerjakan siswa. Kembalikan ke draft bila ingin mengubah bagian atau soal.
        </div>
    }

    @if (paket.Bagians.Count == 0 && !tampilFormBagian)
    {
        <div class="card">
            <div class="empty">
                <span class="icon-bubble icon-bubble-lg icon-bubble-ungu">
                    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 6h16M4 12h16M4 18h10" />
                    </svg>
                </span>
                <h3>Belum ada bagian</h3>
                <p>Bagian adalah kelompok soal, biasanya mewakili satu mata pelajaran. Tambahkan bagian dulu.</p>
                <button class="btn btn-primary" @onclick="() => BukaFormBagian(null)">Tambah Bagian</button>
            </div>
        </div>
    }

    @if (paket.Bagians.Count > 0)
    {
        <div class="toolbar" style="margin-bottom:16px">
            <span class="badge badge-biru">@paket.Bagians.Count bagian</span>
            <div class="grow"></div>
            @if (!paket.IsPublished)
            {
                <button class="btn btn-primary btn-sm" @onclick="() => BukaFormBagian(null)">+ Tambah Bagian</button>
            }
        </div>
    }

    @foreach (var bagian in paket.Bagians)
    {
        <div class="card" style="margin-bottom:16px">
            <div class="card-head">
                <div class="grow">
                    <span class="muted-sm">Bagian @bagian.Urutan</span>
                    <h2 style="margin:2px 0 0">@bagian.Judul</h2>
                    @if (!string.IsNullOrWhiteSpace(bagian.Deskripsi))
                    {
                        <span class="cell-sub">@bagian.Deskripsi</span>
                    }
                </div>
                <div class="btn-row">
                    <span class="badge badge-biru">@bagian.Soals.Count soal · bobot @BobotBagian(bagian).ToString("0.##")</span>
                    @if (!paket.IsPublished)
                    {
                        <button class="icon-btn ib-tambah" title="Tambah soal di bagian ini"
                                @onclick="() => BukaFormSoal(bagian.Id, null)">
                            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 5v14M5 12h14" />
                            </svg>
                        </button>
                        <button class="icon-btn ib-edit" title="Ubah bagian"
                                @onclick="() => BukaFormBagian(bagian)">
                            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 20h9" />
                                <path d="M16.5 3.5a2.12 2.12 0 013 3L7 19l-4 1 1-4L16.5 3.5z" />
                            </svg>
                        </button>
                        <button class="icon-btn danger" title="Hapus bagian" disabled="@sedangAksi"
                                @onclick="() => HapusBagianAsync(bagian.Id)">
                            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 6h18" />
                                <path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6" />
                                <path d="M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2" />
                                <path d="M10 11v6M14 11v6" />
                            </svg>
                        </button>
                    }
                </div>
            </div>

            @if (bagian.Soals.Count == 0)
            {
                <p class="text-muted" style="padding:0 20px 8px">Belum ada soal di bagian ini.</p>
            }
            else
            {
                <div class="soal-list">
                    @foreach (var s in bagian.Soals)
                    {
                        <div class="soal-item">
                            <span class="soal-no">@s.Urutan</span>

                            <div class="soal-info">
                                <span class="soal-teks">@s.Teks</span>
                                <div class="soal-meta">
                                    <div class="soal-badges">
                                        <span class="badge badge-ungu">@JenisSoal.Singkat(s.Jenis)</span>
                                        <span class="badge badge-abu">bobot @s.Bobot.ToString("0.##")</span>
                                        @if (s.Wajib)
                                        {
                                            <span class="badge badge-kuning">Wajib</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-abu">Opsional</span>
                                        }
                                    </div>

                                    <div class="soal-actions">
                                        @if (!paket.IsPublished)
                                        {
                                            <button class="icon-btn ib-edit" title="Ubah soal"
                                                    @onclick="() => BukaFormSoal(bagian.Id, s)">
                                                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor"
                                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M12 20h9" />
                                                    <path d="M16.5 3.5a2.12 2.12 0 013 3L7 19l-4 1 1-4L16.5 3.5z" />
                                                </svg>
                                            </button>
                                            <button class="icon-btn ib-salin" title="Salin soal (jadikan soal baru)"
                                                    @onclick="() => BukaFormSoal(bagian.Id, s, true)">
                                                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor"
                                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <rect x="9" y="9" width="12" height="12" rx="2" />
                                                    <path d="M5 15V5a2 2 0 012-2h10" />
                                                </svg>
                                            </button>
                                            <button class="icon-btn danger" title="Hapus soal" disabled="@sedangAksi"
                                                    @onclick="() => HapusSoalAsync(s.Id)">
                                                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor"
                                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M3 6h18" />
                                                    <path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6" />
                                                    <path d="M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2" />
                                                    <path d="M10 11v6M14 11v6" />
                                                </svg>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (!paket.IsPublished)
            {
                <div style="padding:0 20px 16px">
                    <button class="btn btn-ghost btn-sm"
                            @onclick="() => BukaFormSoal(bagian.Id, null)">+ Tambah Soal</button>
                </div>
            }
        </div>
    }

    @if (!paket.IsPublished && tampilFormBagian)
    {
        <div class="overlay-backdrop">
            <div class="modal-card modal-wide" @onclick:stopPropagation>
                <div class="modal-head">
                    <div>
                        <h3>@(editBagianId is null or 0 ? "Tambah Bagian" : "Ubah Bagian")</h3>
                        <span class="muted-sm text-muted">Kelompok soal, biasanya satu mata pelajaran.</span>
                    </div>
                    <button type="button" class="btn btn-quiet btn-sm" @onclick="BatalFormBagian" title="Tutup">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                             stroke-width="2.2" stroke-linecap="round">
                            <path d="M18 6L6 18M6 6l12 12" />
                        </svg>
                        Tutup
                    </button>
                </div>

                <div class="modal-body">
                    <div class="field">
                        <label class="label">Judul bagian / mata pelajaran</label>
                        <input class="input" @bind="bagianForm.Judul" placeholder="Contoh: Matematika" />
                    </div>
                    <div class="field">
                        <label class="label">Deskripsi <span class="text-muted">(opsional)</span></label>
                        <input class="input" @bind="bagianForm.Deskripsi" placeholder="Petunjuk bagian..." />
                    </div>
                    @if (error is not null)
                    {
                        <div class="alert alert-danger">@error</div>
                    }
                </div>

                <div class="modal-foot">
                    <button class="btn btn-primary" disabled="@sedangAksi" @onclick="() => SimpanBagianAsync(editBagianId)">
                        @(sedangAksi ? "Menyimpan..." : "Simpan Bagian")
                    </button>
                    <button class="btn btn-quiet" @onclick="BatalFormBagian">Batal</button>
                </div>
            </div>
        </div>
    }

    @if (formBagianId is not null && !paket.IsPublished)
    {
        <div class="overlay-backdrop">
            <div class="modal-card modal-wide" @onclick:stopPropagation>
                <div class="modal-head">
                    <div>
                        <h3>@(editSoalId is null or 0 ? (sedangSalin ? "Salin Soal" : "Tambah Soal") : "Ubah Soal")</h3>
                        <span class="muted-sm text-muted">
                            Bagian @formBagianJudul · @JenisSoal.Singkat(soalForm.Jenis)
                            @if (PakaiOpsi(soalForm.Jenis))
                            {
                                <span> · @soalForm.Options.Count @(soalForm.Jenis == JenisSoal.MatrixSkala ? "baris" : "opsi")</span>
                            }
                            <span> · bobot @soalForm.Bobot.ToString("0.##")</span>
                        </span>
                    </div>
                    <button type="button" class="btn btn-quiet btn-sm" @onclick="TutupFormSoal" title="Tutup">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                             stroke-width="2.2" stroke-linecap="round">
                            <path d="M18 6L6 18M6 6l12 12" />
                        </svg>
                        Tutup
                    </button>
                </div>

                <div class="modal-body">
                    <div class="field">
                        <label class="label">Pertanyaan / teks soal</label>
                        <textarea class="input" rows="2" @bind="soalForm.Teks"
                                  placeholder="Tulis pertanyaan di sini..."></textarea>
                    </div>

                    <div class="field">
                        <label class="label">Jenis soal</label>
                        <select class="input" value="@soalForm.Jenis" @onchange="e => GantiJenis(e.Value?.ToString())">
                            @foreach (var (nilai, label) in JenisSoal.Pilihan)
                            {
                                <option value="@nilai" selected="@(soalForm.Jenis == nilai)">@label</option>
                            }
                        </select>
                        <p class="hint">@HintJenis</p>
                    </div>

                    <div class="field-row">
                        <div class="field">
                            <label class="label">Bobot soal</label>
                            <input class="input" style="max-width:160px" type="number" step="0.1" min="0.1"
                                   @bind="soalForm.Bobot" />
                            <p class="hint">Bobot menentukan sumbangan soal ini ke skor akhir (min. 0.1).</p>
                        </div>
                        <div class="field">
                            <label class="label">Wajib diisi?</label>
                            <label class="check">
                                <input type="checkbox" @bind="soalForm.Wajib" />
                                <span>Ya, wajib dijawab</span>
                            </label>
                        </div>
                    </div>

                    <div class="section-title" style="margin-top:18px">
                        <div>
                            <h3>Kunci dan pilihan jawaban</h3>
                            <p>Tandai jawaban yang benar supaya peserta bisa dinilai otomatis.</p>
                        </div>
                    </div>

                    @if (PakaiOpsi(soalForm.Jenis))
                    {
                        <div class="flex-between" style="margin-bottom:12px">
                            <p class="hint" style="margin:0">
                                @(soalForm.Jenis == JenisSoal.MatrixSkala
                                    ? "Tulis setiap baris; kunci nilai tiap baris bersifat opsional."
                                    : soalForm.Jenis == JenisSoal.Checkbox
                                        ? "Centang satu atau lebih jawaban yang benar."
                                        : "Pilih bulatan di kiri untuk menandai jawaban yang benar.")
                            </p>
                            <span class="badge @(JumlahBenar == 0 && soalForm.Jenis != JenisSoal.MatrixSkala ? "badge-merah" : "badge-hijau")">
                                @if (soalForm.Jenis == JenisSoal.MatrixSkala)
                                {
                                    @($"{JumlahBenar}/{soalForm.Options.Count} baris berisi kunci")
                                }
                                else
                                {
                                    @($"{JumlahBenar} jawaban benar")
                                }
                            </span>
                        </div>

                        <div class="opsi-list">
                            @for (var i = 0; i < soalForm.Options.Count; i++)
                            {
                                var n = i;
                                <div>
                                    <div class="opsi-editor">
                                        @if (soalForm.Jenis == JenisSoal.MatrixSkala)
                                        {
                                            <span class="opsi-huruf">@(n + 1)</span>

                                            <input class="input" placeholder="@($"Baris {n + 1}")"
                                                   @bind="soalForm.Options[n].Teks" @bind:event="oninput"
                                                   aria-label="@($"Baris {n + 1}")" />

                                            <select class="input" style="max-width:150px"
                                                    value="@(soalForm.Options[n].NilaiBenar?.ToString() ?? "")"
                                                    @onchange="e => SetNilaiBaris(n, e.Value?.ToString())"
                                                    aria-label="Jawaban benar baris ini">
                                                <option value="">Pilih kunci</option>
                                                @for (var v = SkalaAtas; v >= SkalaBawah; v--)
                                                {
                                                    <option value="@v">@v</option>
                                                }
                                            </select>

                                            <button type="button" class="btn btn-quiet btn-sm"
                                                    disabled="@(soalForm.Options.Count <= 1)"
                                                    title="Hapus baris"
                                                    @onclick="() => HapusOpsi(n)">
                                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                                                     stroke-width="2.2" stroke-linecap="round">
                                                    <path d="M18 6L6 18M6 6l12 12" />
                                                </svg>
                                            </button>
                                        }
                                        else
                                        {
                                            <label class="opsi-radio" title="Tandai sebagai jawaban benar">
                                                <input type="@(BisaBanyakBenar ? "checkbox" : "radio")"
                                                       name="benar"
                                                       checked="@soalForm.Options[n].IsBenar"
                                                       @onchange="() => SetBenar(n)" />
                                            </label>

                                            <span class="opsi-huruf">@Huruf(n)</span>

                                            <input class="input" placeholder="@($"Opsi {Huruf(n)}")"
                                                   @bind="soalForm.Options[n].Teks" @bind:event="oninput"
                                                   aria-label="@($"Opsi {Huruf(n)}")" />

                                            <button type="button" class="btn btn-quiet btn-sm"
                                                    disabled="@(soalForm.Options.Count <= 2)"
                                                    title="Hapus opsi"
                                                    @onclick="() => HapusOpsi(n)">
                                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                                                     stroke-width="2.2" stroke-linecap="round">
                                                    <path d="M18 6L6 18M6 6l12 12" />
                                                </svg>
                                            </button>
                                        }
                                    </div>

                                    @if (opsiDiperiksa
                                        && string.IsNullOrWhiteSpace(soalForm.Options[n].Teks))
                                    {
                                        <div class="validation-message">
                                            Baris ini masih kosong
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <button type="button" class="btn btn-soft btn-sm" style="margin-top:12px"
                                disabled="@(soalForm.Options.Count >= 20)" @onclick="TambahOpsi">
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 5v14M5 12h14" />
                            </svg>
                            @(soalForm.Jenis == JenisSoal.MatrixSkala ? "Tambah baris" : "Tambah opsi")
                        </button>
                    }
                    else
                    {
                        @if (ButuhSkala)
                        {
                            <div class="grid-2">
                                <div class="field">
                                    <label class="label">Skala terendah</label>
                                    <input class="input" type="number" @bind="soalForm.SkalaMin" @bind:event="onchange" />
                                </div>
                                <div class="field">
                                    <label class="label">Skala tertinggi</label>
                                    <input class="input" type="number" @bind="soalForm.SkalaMax" @bind:event="onchange" />
                                </div>
                                <div class="field">
                                    <label class="label">Label skala terendah <span class="text-muted">(opsional)</span></label>
                                    <input class="input" @bind="soalForm.LabelSkalaMin" placeholder="Contoh: Sangat kurang" />
                                </div>
                                <div class="field">
                                    <label class="label">Label skala tertinggi <span class="text-muted">(opsional)</span></label>
                                    <input class="input" @bind="soalForm.LabelSkalaMax" placeholder="Contoh: Sangat baik" />
                                </div>
                            </div>
                        }

                        @if (soalForm.Jenis == JenisSoal.RateScale)
                        {
                            <div class="field">
                                <label class="label">Kunci jawaban <span class="text-muted">(opsional)</span></label>
                                <input class="input" style="max-width:220px" type="number"
                                       @bind="soalForm.NilaiRate" @bind:event="onchange" />
                                <p class="hint">
                                    Isi angka antara @SkalaBawah sampai @SkalaAtas yang dianggap benar.
                                    Kosongkan bila soal tidak perlu dinilai otomatis.
                                </p>
                            </div>
                        }
                        else if (soalForm.Jenis == JenisSoal.Angka)
                        {
                            <div class="field">
                                <label class="label">Kunci jawaban</label>
                                <input class="input" style="max-width:220px" type="number" step="any"
                                       @bind="soalForm.JawabanBenar" placeholder="Contoh: 12.5" />
                                <p class="hint">Soal ini dinilai otomatis berdasarkan kecocokan angka.</p>
                            </div>
                        }
                        else if (soalForm.Jenis == JenisSoal.Tanggal)
                        {
                            <div class="field">
                                <label class="label">Kunci jawaban <span class="text-muted">(opsional)</span></label>
                                <input class="input" style="max-width:220px" type="date"
                                       value="@soalForm.JawabanBenar"
                                       @onchange="e => soalForm.JawabanBenar = e.Value?.ToString()" />
                                <p class="hint">
                                    Dinilai otomatis berdasarkan tanggal yang dipilih peserta.
                                    Kosongkan bila soal tidak perlu dinilai otomatis.
                                </p>
                            </div>
                        }
                        else if (soalForm.Jenis == JenisSoal.TeksSingkat)
                        {
                            <div class="field">
                                <label class="label">Kunci jawaban</label>
                                <input class="input" @bind="soalForm.JawabanBenar" placeholder="Contoh: Jakarta" />
                                <p class="hint">
                                    Pisahkan beberapa jawaban yang diterima dengan tanda <b>|</b>,
                                    contoh: <i>Jakarta|DKI Jakarta</i>. Perbandingan tidak membedakan huruf besar/kecil.
                                </p>
                            </div>
                        }
                        else if (soalForm.Jenis == JenisSoal.TeksPanjang)
                        {
                            <div class="field">
                                <label class="label">Kunci jawaban / panduan penskoran <span class="text-muted">(opsional)</span></label>
                                <textarea class="input" rows="3" @bind="soalForm.JawabanBenar"
                                          placeholder="Poin-poin yang harus ada dalam jawaban peserta..."></textarea>
                                <p class="hint">
                                    Soal essay dinilai manual oleh pengawas dari halaman Koreksi.
                                    Nilainya dijumlahkan ke skor akhir peserta.
                                </p>
                            </div>
                        }
                    }

                    @if (formError is not null)
                    {
                        <div class="alert alert-danger" style="margin-top:18px">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="9" />
                                <path d="M12 8v5M12 16h.01" />
                            </svg>
                            @formError
                        </div>
                    }
                </div>

                <div class="modal-foot">
                    <button class="btn btn-primary" disabled="@sedangAksi"
                            @onclick="() => SimpanSoalAsync(formBagianId!.Value)">
                        @(sedangAksi ? "Menyimpan..." : "Simpan Soal")
                    </button>
                    <button class="btn btn-quiet" @onclick="TutupFormSoal">Batal</button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private PaketUjianDetailDto? paket;
    private bool memuat = true;
    private bool sedangAksi;
    private string? pesan;
    private string? error;
    private string? formError;
    private bool opsiDiperiksa;

    private bool tampilFormBagian;
    private int? editBagianId;
    private BagianForm bagianForm = new();

    private int? formBagianId;
    private int? editSoalId;
    private bool sedangSalin;
    private string? formBagianJudul;
    private SoalForm soalForm = new();

    private bool PakaiJadwal =>
        !(paket?.WaktuTutup == default
          || paket?.WaktuBuka == new DateTime(2000, 1, 1) && paket?.WaktuTutup == new DateTime(2100, 1, 1));

    private int JumlahSoal => paket?.Bagians.Sum(b => b.Soals.Count) ?? 0;

    private decimal BobotBagian(BagianDto bagian) => bagian.Soals.Sum(s => s.Bobot);

    protected override async Task OnInitializedAsync()
    {
        pesan = UrlQuery.Baca(Nav.Uri, "pesan");
        await MuatAsync();
    }

    private async Task MuatAsync()
    {
        memuat = true;
        var hasil = await Api.AmbilPaketAsync(Id);
        memuat = false;

        if (hasil.Berhasil && hasil.Data is not null)
        {
            paket = hasil.Data;
            error = null;
        }
        else
        {
            paket = null;
            error = hasil.Error;
        }
    }

    private async Task PublishAsync()
    {
        if (sedangAksi)
            return;

        sedangAksi = true;
        pesan = null;
        error = null;

        var hasil = await Api.PublikasikanPaketAsync(Id);
        sedangAksi = false;

        if (hasil.Berhasil)
        {
            pesan = "Paket ujian berhasil dipublikasikan.";
            await MuatAsync();
        }
        else
        {
            error = hasil.Error;
        }
    }

    private async Task DuplikatAsync()
    {
        if (sedangAksi)
            return;

        sedangAksi = true;
        pesan = null;
        error = null;

        var hasil = await Api.DuplikatPaketAsync(Id);
        sedangAksi = false;

        if (hasil.Berhasil && hasil.Data?.Id is { } idBaru)
        {
            Nav.NavigateTo($"paket-ujian/{idBaru}");
        }
        else
        {
            error = hasil.Error;
        }
    }

    private async Task TutupAsync()
    {
        if (sedangAksi)
            return;

        sedangAksi = true;
        pesan = null;
        error = null;

        var hasil = await Api.TutupPaketAsync(Id);
        sedangAksi = false;

        if (hasil.Berhasil)
        {
            pesan = "Paket ujian dikembalikan ke draft.";
            await MuatAsync();
        }
        else
        {
            error = hasil.Error;
        }
    }

    // ===== Bagian =====

    private void BukaFormBagian(BagianDto? bagian)
    {
        tampilFormBagian = true;
        editBagianId = bagian?.Id;
        bagianForm = new BagianForm
        {
            Judul = bagian?.Judul ?? "",
            Deskripsi = bagian?.Deskripsi ?? ""
        };
        TutupFormSoal();
        error = null;
    }

    private void BatalFormBagian()
    {
        tampilFormBagian = false;
        editBagianId = null;
        bagianForm = new BagianForm();
        error = null;
    }

    private async Task SimpanBagianAsync(int? bagianId)
    {
        if (sedangAksi)
            return;

        if (string.IsNullOrWhiteSpace(bagianForm.Judul))
        {
            error = "Judul bagian wajib diisi.";
            return;
        }

        sedangAksi = true;
        error = null;

        var payload = new BagianUpsertRequest(bagianForm.Judul.Trim(), KosongKeNull(bagianForm.Deskripsi));

        var hasil = bagianId is > 0
            ? await Api.UbahBagianAsync(bagianId.Value, payload)
            : await Api.TambahBagianAsync(Id, payload);

        sedangAksi = false;

        if (hasil.Berhasil)
        {
            pesan = "Bagian berhasil disimpan.";
            BatalFormBagian();
            await MuatAsync();
        }
        else
        {
            error = hasil.Error;
        }
    }

    private async Task HapusBagianAsync(int bagianId)
    {
        if (sedangAksi)
            return;

        sedangAksi = true;
        pesan = null;
        error = null;

        var hasil = await Api.HapusBagianAsync(bagianId);
        sedangAksi = false;

        if (hasil.Berhasil)
        {
            pesan = "Bagian berhasil dihapus.";
            await MuatAsync();
        }
        else
        {
            error = hasil.Error;
        }
    }

    // ===== Soal =====

    private void BukaFormSoal(int bagianId, ButirSoalDto? soal, bool sebagaiSalinan = false)
    {
        formBagianId = bagianId;
        formBagianJudul = paket?.Bagians.FirstOrDefault(b => b.Id == bagianId)?.Judul ?? "";
        editSoalId = soal is { } asli && !sebagaiSalinan ? asli.Id : null;
        sedangSalin = sebagaiSalinan;
        formError = null;
        opsiDiperiksa = false;

        soalForm = new SoalForm
        {
            Teks = soal?.Teks ?? "",
            Jenis = soal != null && JenisSoal.Dikenal(soal.Jenis) ? soal.Jenis : JenisSoal.Bawaan,
            Wajib = soal?.Wajib ?? false,
            Bobot = soal is { Bobot: > 0 } ? soal.Bobot : 1,
            SkalaMin = soal?.SkalaMin > 0 ? soal.SkalaMin : 1,
            SkalaMax = soal?.SkalaMax > 0 ? soal.SkalaMax : 5,
            LabelSkalaMin = soal?.LabelSkalaMin,
            LabelSkalaMax = soal?.LabelSkalaMax,
            JawabanBenar = soal?.JawabanBenar
        };

        var jenis = soalForm.Jenis;

        if (jenis == JenisSoal.Tanggal && DateTime.TryParse(soalForm.JawabanBenar, out var tgl))
            soalForm.JawabanBenar = tgl.ToString("yyyy-MM-dd");

        if (jenis == JenisSoal.RateScale && int.TryParse(soalForm.JawabanBenar, out var nilaiRate))
            soalForm.NilaiRate = nilaiRate;

        soalForm.Options = soal is { Options.Count: > 0 }
            ? soal.Options
                .OrderBy(o => o.Urutan)
                .Select(o => new OpsiFormModel
                {
                    Teks = o.Teks,
                    IsBenar = o.IsBenar,
                    NilaiBenar = o.NilaiBenar
                })
                .ToList()
            : OpsiKosong(jenis);

        if (soalForm.Options.Count == 0)
            soalForm.Options = OpsiKosong(jenis);
    }

    private static List<OpsiFormModel> OpsiKosong(string jenis)
    {
        var jumlah = jenis == JenisSoal.MatrixSkala ? 3 : 4;
        return Enumerable.Range(0, jumlah).Select(_ => new OpsiFormModel()).ToList();
    }

    private void TutupFormSoal()
    {
        formBagianId = null;
        formBagianJudul = null;
        editSoalId = null;
        sedangSalin = false;
        soalForm = new SoalForm();
        formError = null;
        opsiDiperiksa = false;
    }

    private bool PakaiOpsi(string? jenis) => JenisSoal.PakaiOpsi(jenis);
    private bool BisaBanyakBenar => JenisSoal.BanyakBenar(soalForm.Jenis);
    private bool ButuhSkala => JenisSoal.ButuhSkala(soalForm.Jenis);

    private int SkalaBawah => (soalForm.SkalaMin ?? 0) > 0 ? soalForm.SkalaMin!.Value : 1;
    private int SkalaAtas => Math.Max((soalForm.SkalaMax ?? 0) > 0 ? soalForm.SkalaMax!.Value : 5, SkalaBawah);

    private int JumlahBenar => soalForm.Options.Count(o =>
        soalForm.Jenis == JenisSoal.MatrixSkala ? o.NilaiBenar is not null : o.IsBenar);

    private string HintJenis => soalForm.Jenis switch
    {
        JenisSoal.PilihanGanda => "Satu jawaban benar, peserta memilih lewat bulatan (radio button).",
        JenisSoal.Dropdown => "Satu jawaban benar, peserta memilih dari daftar tarik-turun.",
        JenisSoal.Checkbox => "Boleh lebih dari satu jawaban benar, peserta menandai centang.",
        JenisSoal.TeksSingkat => "Jawaban berupa kata atau kalimat pendek, dinilai otomatis.",
        JenisSoal.TeksPanjang => "Jawaban bebas, dinilai manual oleh pengawas.",
        JenisSoal.Angka => "Jawaban berupa angka, dinilai otomatis.",
        JenisSoal.Tanggal => "Jawaban berupa tanggal, dinilai otomatis.",
        JenisSoal.RateScale => "Peserta memilih satu angka pada skala yang telah ditentukan.",
        JenisSoal.MatrixSkala => "Beberapa baris pertanyaan, tiap baris dijawab dengan skala yang sama.",
        _ => ""
    };

    private void GantiJenis(string? jenisBaru)
    {
        var jenisLama = soalForm.Jenis;
        var jenis = JenisSoal.Dikenal(jenisBaru) ? jenisBaru! : JenisSoal.Bawaan;

        if (jenis != jenisLama && jenis == JenisSoal.RateScale)
            soalForm.NilaiRate = null;                     // default tanpa kunci

        soalForm.Jenis = jenis;
        formError = null;
        opsiDiperiksa = false;

        if (soalForm.Jenis == JenisSoal.TeksPanjang)
        {
            soalForm.Options = new List<OpsiFormModel>();
            return;
        }

        if (!PakaiOpsi(soalForm.Jenis))
        {
            soalForm.Options = new List<OpsiFormModel>();
        }
        else if (soalForm.Options.Count == 0)
        {
            soalForm.Options = OpsiKosong(soalForm.Jenis);
        }
        else if (soalForm.Jenis == JenisSoal.MatrixSkala)
        {
            foreach (var opsi in soalForm.Options)
            {
                if (opsi.NilaiBenar is null || opsi.NilaiBenar < SkalaBawah || opsi.NilaiBenar > SkalaAtas)
                    opsi.NilaiBenar = null;
            }
        }
    }

    private static string Huruf(int index)
    {
        if (index < 26) return ((char)('A' + index)).ToString();
        return (char)('A' + (index / 26 - 1)) + ((char)('A' + (index % 26))).ToString();
    }

    private void SetBenar(int index)
    {
        if (BisaBanyakBenar)
        {
            soalForm.Options[index].IsBenar = !soalForm.Options[index].IsBenar;
            return;
        }

        for (var i = 0; i < soalForm.Options.Count; i++)
            soalForm.Options[i].IsBenar = i == index;
    }

    private void SetNilaiBaris(int index, string? teks) =>
        soalForm.Options[index].NilaiBenar = int.TryParse(teks, out var nilai) ? nilai : null;

    private void TambahOpsi() => soalForm.Options.Add(new OpsiFormModel());

    private void HapusOpsi(int index)
    {
        var tetapBenar = soalForm.Options[index].IsBenar;
        soalForm.Options.RemoveAt(index);

        if (tetapBenar && soalForm.Options.Count > 0 && !BisaBanyakBenar)
            soalForm.Options[0].IsBenar = true;
    }

    private async Task SimpanSoalAsync(int bagianId)
    {
        if (sedangAksi)
            return;

        formError = null;
        opsiDiperiksa = false;

        if (string.IsNullOrWhiteSpace(soalForm.Teks))
        {
            formError = "Teks soal wajib diisi.";
            return;
        }

        if (soalForm.Bobot <= 0)
        {
            formError = "Bobot soal harus lebih dari 0.";
            return;
        }

        if (PakaiOpsi(soalForm.Jenis))
        {
            var minimal = soalForm.Jenis == JenisSoal.MatrixSkala ? 1 : 2;
            if (soalForm.Options.Count < minimal)
            {
                formError = soalForm.Jenis == JenisSoal.MatrixSkala
                    ? "Minimal satu baris matriks."
                    : "Minimal 2 pilihan jawaban.";
                return;
            }

            if (soalForm.Options.Any(o => string.IsNullOrWhiteSpace(o.Teks)))
            {
                opsiDiperiksa = true;
                formError = "Semua baris matriks harus diisi, atau hapus baris yang kosong.";
                return;
            }

            if (soalForm.Jenis != JenisSoal.MatrixSkala && JumlahBenar == 0)
            {
                formError = soalForm.Jenis == JenisSoal.Checkbox
                    ? "Pilih minimal satu jawaban yang benar."
                    : "Pilih tepat satu jawaban yang benar.";
                return;
            }

            if (soalForm.Jenis != JenisSoal.MatrixSkala && !BisaBanyakBenar && JumlahBenar != 1)
            {
                formError = "Pilih tepat satu jawaban yang benar.";
                return;
            }
        }

        if (ButuhSkala)
        {
            if (SkalaBawah < 1)
            {
                formError = "Skala minimal harus lebih besar dari 0.";
                return;
            }

            if (SkalaAtas < SkalaBawah)
            {
                formError = "Skala maksimal tidak boleh lebih kecil dari skala minimal.";
                return;
            }
        }

        string? kunci = string.IsNullOrWhiteSpace(soalForm.JawabanBenar) ? null : soalForm.JawabanBenar.Trim();

        switch (soalForm.Jenis)
        {
            case JenisSoal.RateScale:
                if (soalForm.NilaiRate is not null)
                {
                    if (soalForm.NilaiRate < SkalaBawah || soalForm.NilaiRate > SkalaAtas)
                    {
                        formError = $"Kunci jawaban harus antara {SkalaBawah} sampai {SkalaAtas}.";
                        return;
                    }
                    kunci = soalForm.NilaiRate.Value.ToString();
                }
                break;

            case JenisSoal.Angka:
                if (kunci is null || !decimal.TryParse(kunci, out _))
                {
                    formError = "Kunci jawaban harus berupa angka yang valid.";
                    return;
                }
                break;

            case JenisSoal.Tanggal:
                if (kunci is not null)
                {
                    if (!DateTime.TryParse(kunci, out var tgl))
                    {
                        formError = "Kunci jawaban harus berupa tanggal yang valid.";
                        return;
                    }
                    kunci = tgl.ToString("yyyy-MM-dd");
                }
                break;

            case JenisSoal.TeksSingkat:
                if (kunci is null)
                {
                    formError = "Kunci jawaban wajib diisi.";
                    return;
                }
                break;
        }

        sedangAksi = true;

        var options = PakaiOpsi(soalForm.Jenis)
            ? soalForm.Options
                .Where(o => !string.IsNullOrWhiteSpace(o.Teks))
                .Select(o => new OpsiButirRequest(
                    o.Teks.Trim(),
                    soalForm.Jenis != JenisSoal.MatrixSkala && o.IsBenar,
                    soalForm.Jenis == JenisSoal.MatrixSkala ? o.NilaiBenar : null))
                .ToList()
            : new List<OpsiButirRequest>();

        var payload = new SoalPaketUpsertRequest(
            soalForm.Teks.Trim(),
            soalForm.Jenis,
            soalForm.Wajib,
            options,
            ButuhSkala ? SkalaBawah : null,
            ButuhSkala ? SkalaAtas : null,
            ButuhSkala && !string.IsNullOrWhiteSpace(soalForm.LabelSkalaMin) ? soalForm.LabelSkalaMin.Trim() : null,
            ButuhSkala && !string.IsNullOrWhiteSpace(soalForm.LabelSkalaMax) ? soalForm.LabelSkalaMax.Trim() : null,
            kunci,
            soalForm.Bobot);

        var hasil = editSoalId is > 0
            ? await Api.UbahSoalPaketAsync(editSoalId.Value, payload)
            : await Api.TambahSoalPaketAsync(bagianId, payload);

        sedangAksi = false;

        if (hasil.Berhasil)
        {
            pesan = "Soal berhasil disimpan.";
            TutupFormSoal();
            await MuatAsync();
        }
        else
        {
            formError = hasil.Error;
        }
    }

    private async Task HapusSoalAsync(int soalId)
    {
        if (sedangAksi)
            return;

        sedangAksi = true;
        pesan = null;
        error = null;

        var hasil = await Api.HapusSoalPaketAsync(soalId);
        sedangAksi = false;

        if (hasil.Berhasil)
        {
            pesan = "Soal berhasil dihapus.";
            await MuatAsync();
        }
        else
        {
            error = hasil.Error;
        }
    }

    // ===== Util =====

    private static string KunciSingkat(ButirSoalDto s)
    {
        if (JenisSoal.PakaiOpsi(s.Jenis))
        {
            if (JenisSoal.ButuhBaris(s.Jenis))
            {
                var isi = s.Options
                    .Where(o => o.NilaiBenar is not null)
                    .Select(o => $"{o.NilaiBenar}({o.Teks?.Trim()})")
                    .ToList();
                return isi.Count == 0
                    ? "Tanpa kunci · tidak dinilai otomatis"
                    : ($"{isi.Count} dari {s.Options.Count} baris berisi kunci · " + string.Join(" · ", isi));
            }

            var benar = s.Options
                .Where(o => o.IsBenar)
                .Select(o => o.Teks?.Trim())
                .ToList();
            return benar.Count == 0 ? "Belum ada kunci" : "Kunci: " + string.Join(", ", benar);
        }

        if (s.Jenis == JenisSoal.TeksPanjang)
            return string.IsNullOrWhiteSpace(s.JawabanBenar) ? "Essay · tanpa panduan" : "Essay · panduan tersedia";

        if (s.Jenis == JenisSoal.RateScale)
            return string.IsNullOrWhiteSpace(s.JawabanBenar)
                ? "Tanpa kunci · tidak dinilai otomatis"
                : $"Kunci: {s.JawabanBenar} (skala {s.SkalaMin}-{s.SkalaMax})";

        if (s.Jenis == JenisSoal.MatrixSkala)
            return $"Tanpa kunci · tidak dinilai otomatis";

        if (s.Jenis == JenisSoal.Tanggal)
            return string.IsNullOrWhiteSpace(s.JawabanBenar)
                ? "Tanpa kunci · tidak dinilai otomatis"
                : "Kunci: " + s.JawabanBenar;

        return string.IsNullOrWhiteSpace(s.JawabanBenar)
            ? "Belum ada kunci"
            : "Kunci: " + s.JawabanBenar;
    }

    private static string? KosongKeNull(string? teks) => string.IsNullOrWhiteSpace(teks) ? null : teks.Trim();

    private sealed class BagianForm
    {
        public string Judul { get; set; } = "";
        public string? Deskripsi { get; set; }
    }

    private sealed class SoalForm
    {
        public string Teks { get; set; } = "";
        public string Jenis { get; set; } = JenisSoal.Bawaan;
        public bool Wajib { get; set; }
        public decimal Bobot { get; set; } = 1;

        public string? JawabanBenar { get; set; }

        public int? SkalaMin { get; set; } = 1;
        public int? SkalaMax { get; set; } = 5;

        public string? LabelSkalaMin { get; set; }
        public string? LabelSkalaMax { get; set; }

        public int? NilaiRate { get; set; }

        public List<OpsiFormModel> Options { get; set; } = new();
    }

    private sealed class OpsiFormModel
    {
        public string Teks { get; set; } = "";
        public bool IsBenar { get; set; }
        public int? NilaiBenar { get; set; }
    }
}